# Puerto del backend de Cobrix
PORT=4320
# URL por defecto de la API del administrador. Se puede cambiar desde Configuración → Proveedor.
ADMIN_API_URL=http://127.0.0.1:4310/api/v1
ADMIN_API_TIMEOUT_MS=10000
# Clave con la que se cifra la contraseña del proveedor. Cámbiala.
ENCRYPTION_KEY=cambia-esta-clave
# Base SQLite propia de Cobrix (ruta relativa a prisma/)
DATABASE_URL=file:./data/cobrix.sqlite
# Fecha de negocio fija (YYYY-MM-DD). La prueba usa 2026-10-13; vacío = hoy en la zona horaria de la empresa.
BUSINESS_DATE=2026-10-13
